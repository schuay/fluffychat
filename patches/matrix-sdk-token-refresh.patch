@@ -0,0 +1,321 @@
+// SPDX-FileCopyrightText: 2026 Contributors to FluffyChat
+//
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:http/http.dart' as http;
+import 'package:matrix/encryption/utils/pickle_key.dart';
+import 'package:matrix/matrix.dart';
+import 'package:sqflite_common_ffi/sqflite_ffi.dart';
+import 'package:test/test.dart';
+import 'package:vodozemac/vodozemac.dart' as vod;
+
+import 'fake_client.dart';
+import 'fake_database.dart';
+
+class DelayedRefreshApi extends FakeMatrixApi {
+  final started = Completer<void>();
+  final finish = Completer<void>();
+  bool delayRefresh = false;
+  bool rejectReadMarker = false;
+  int deviceKeyUploads = 0;
+
+  @override
+  Future<http.Response> mockIntercept(http.Request request) async {
+    if (rejectReadMarker && request.url.path.endsWith('/read_markers')) {
+      return http.Response(
+        jsonEncode({
+          'errcode': 'M_UNKNOWN_TOKEN',
+          'error': 'Access token has expired',
+          'soft_logout': true,
+        }),
+        401,
+      );
+    }
+    if (delayRefresh && request.url.path.endsWith('/refresh')) {
+      started.complete();
+      await finish.future;
+    }
+    if (request.url.path.endsWith('/keys/upload') &&
+        jsonDecode(request.body)['device_keys'] != null) {
+      deviceKeyUploads++;
+    }
+    return super.mockIntercept(request);
+  }
+}
+
+Future<Client> prepare(DelayedRefreshApi api) async {
+  final seed = await getClient();
+  await seed.dispose(closeDatabase: false);
+  final client = Client(
+    seed.clientName,
+    database: seed.database,
+    httpClient: api,
+    onSoftLogout: (c) => c.refreshAccessToken(),
+  );
+  FakeMatrixApi.currentApi = api;
+  FakeMatrixApi.client = client;
+  await client.init(waitForFirstSync: false);
+  await client.abortSync();
+  expect(client.encryption?.pickledOlmAccount, isNotNull);
+  return client;
+}
+
+Map<String, dynamic> sessionFields(Map<String, dynamic> record) =>
+    Map<String, dynamic>.from(record)
+      ..remove('token')
+      ..remove('token_expires_at')
+      ..remove('refresh_token');
+
+void main() {
+  group('token persistence across database connections', () {
+    late DatabaseApi first;
+    late DatabaseApi second;
+    setUp(() async {
+      final directory = await Directory.systemTemp.createTemp('matrix-tokens-');
+      first = await getDatabase(
+        databasePath: '${directory.path}/client.sqlite',
+      );
+      second = await getDatabase(
+        databasePath: '${directory.path}/client.sqlite',
+      );
+      addTearDown(() async {
+        await first.close();
+        await second.close();
+        await directory.delete(recursive: true);
+      });
+      await first.insertClient(
+        'test',
+        'https://example.invalid',
+        'T0',
+        null,
+        'R0',
+        '@test:example.invalid',
+        'device',
+        null,
+        null,
+        'identity',
+        null,
+      );
+    });
+
+    for (final clearSession in [false, true]) {
+      test(
+        'rejects stale refresh after external change (clear: $clearSession)',
+        () async {
+          expect(
+            await first.updateClientTokens('R0', 'T1', null, 'R1'),
+            isTrue,
+          );
+          if (clearSession) {
+            await second.clear();
+          } else {
+            expect(
+              await second.updateClientTokens('R1', 'T2', null, 'R2'),
+              isTrue,
+            );
+          }
+          expect(
+            await first.updateClientTokens('R1', 'stale', null, 'stale'),
+            isFalse,
+          );
+          final stored = await first.getClient('test');
+          if (clearSession) {
+            expect(stored, isNull);
+          } else {
+            expect(stored!['token'], 'T2');
+            expect(stored['refresh_token'], 'R2');
+            expect(stored['olm_account'], 'identity');
+          }
+        },
+      );
+    }
+
+    test('only one concurrent rotation succeeds', () async {
+      final early = DateTime.fromMillisecondsSinceEpoch(1000);
+      final late = DateTime.fromMillisecondsSinceEpoch(2000);
+      Future<bool?> attempt(
+        DatabaseApi db,
+        String suffix,
+        DateTime expiry,
+      ) async {
+        try {
+          return await db.updateClientTokens(
+            'R0',
+            'T$suffix',
+            expiry,
+            'R$suffix',
+          );
+        } on DatabaseException catch (e) {
+          if (e.getResultCode() == 5) return null;
+          rethrow;
+        }
+      }
+
+      final results = await Future.wait([
+        attempt(first, '1', early),
+        attempt(second, '2', late),
+      ]);
+      expect(results.where((updated) => updated == true), hasLength(1));
+      final winner = results.first == true ? '1' : '2';
+      final stored = (await first.getClient('test'))!;
+      expect(stored['token'], 'T$winner');
+      expect(stored['refresh_token'], 'R$winner');
+      expect(stored['token_expires_at'], '${winner}000');
+      final loser = results.first == true ? second : first;
+      expect(
+        await loser.updateClientTokens('R0', 'stale', null, 'stale'),
+        isFalse,
+      );
+    });
+
+    test(
+      'clears absent expiry and refresh token without changing identity',
+      () async {
+        expect(
+          await first.updateClientTokens('R0', 'T1', DateTime.now(), 'R1'),
+          isTrue,
+        );
+        expect(await first.updateClientTokens('R1', 'T2', null, null), isTrue);
+        final stored = (await first.getClient('test'))!;
+        expect(stored.containsKey('token_expires_at'), isFalse);
+        expect(stored.containsKey('refresh_token'), isFalse);
+        expect(stored['token'], 'T2');
+        expect(stored['olm_account'], 'identity');
+      },
+    );
+  });
+
+  group('token refresh', tags: 'olm', () {
+    test('updates only tokens during normal refresh', () async {
+      final client = await prepare(DelayedRefreshApi());
+      addTearDown(client.dispose);
+      final before = (await client.database.getClient(client.clientName))!;
+      await client.refreshAccessToken();
+      final after = (await client.database.getClient(client.clientName))!;
+      expect(after['token'], 'a_new_token');
+      expect(after['refresh_token'], 'another_new_token');
+      expect(client.accessToken, 'a_new_token');
+      expect(client.accessTokenExpiresAt, isNotNull);
+      expect(sessionFields(after), sessionFields(before));
+    });
+
+    for (final newerKeys in [false, true]) {
+      test(
+        'preserves stored account after disposal (newer keys: $newerKeys)',
+        () async {
+          final api = DelayedRefreshApi();
+          final client = await prepare(api);
+          addTearDown(client.database.close);
+          api.delayRefresh = true;
+          final refresh = client.refreshAccessToken();
+          await api.started.future;
+          if (newerKeys) {
+            final account = vod.Account.fromPickleEncrypted(
+              pickle: client.encryption!.pickledOlmAccount!,
+              pickleKey: client.userID!.toPickleKey(),
+            );
+            account.generateOneTimeKeys(1);
+            await client.database.updateClientKeys(
+              account.toPickleEncrypted(client.userID!.toPickleKey()),
+            );
+          }
+          final before = (await client.database.getClient(client.clientName))!;
+          await client.dispose(closeDatabase: false);
+          expect(client.encryption, isNull);
+          api.finish.complete();
+          await refresh;
+          final after = (await client.database.getClient(client.clientName))!;
+          expect(after['token'], 'a_new_token');
+          expect(sessionFields(after), sessionFields(before));
+        },
+      );
+    }
+
+    test('does not recreate a cleared session', () async {
+      final api = DelayedRefreshApi();
+      final client = await prepare(api);
+      addTearDown(client.dispose);
+      api.delayRefresh = true;
+      final refresh = client.refreshAccessToken();
+      await api.started.future;
+      await client.clear(reason: SessionClearReason.logout);
+      final rejected = expectLater(refresh, throwsStateError);
+      api.finish.complete();
+      await rejected;
+      expect(await client.database.getClient(client.clientName), isNull);
+      expect(client.accessToken, isNull);
+    });
+
+    test(
+      'notification failure during refresh preserves identity on restart',
+      () async {
+        final api = DelayedRefreshApi();
+        final seed = await prepare(api);
+        final stored = (await seed.database.getClient(seed.clientName))!;
+        await seed.database.updateClient(
+          seed.homeserver.toString(),
+          seed.accessToken!,
+          DateTime.now().subtract(const Duration(minutes: 1)),
+          stored['refresh_token'],
+          seed.userID!,
+          seed.deviceID,
+          seed.deviceName,
+          seed.prevBatch,
+          seed.encryption!.pickledOlmAccount,
+          null,
+        );
+        final before = (await seed.database.getClient(seed.clientName))!;
+        final identityKey = seed.identityKey;
+        await seed.dispose(closeDatabase: false);
+        final background = Client(
+          seed.clientName,
+          database: seed.database,
+          httpClient: api,
+          onSoftLogout: (c) => c.refreshAccessToken(),
+        );
+        FakeMatrixApi.client = background;
+        api.delayRefresh = true;
+        api.rejectReadMarker = true;
+        await background.init(
+          waitForFirstSync: false,
+          waitUntilLoadCompletedLoaded: false,
+        );
+        await api.started.future;
+        try {
+          await expectLater(
+            background.setReadMarker(
+              '!room:example.com',
+              mFullyRead: r'$event',
+            ),
+            throwsA(isA<MatrixException>()),
+          );
+        } finally {
+          await background.dispose(closeDatabase: false);
+        }
+        final completed = background.onLoginStateChanged.stream.firstWhere(
+          (state) => state == LoginState.loggedIn,
+        );
+        api.finish.complete();
+        await completed;
+        final after = (await background.database.getClient(seed.clientName))!;
+        expect(after['token'], 'a_new_token');
+        expect(sessionFields(after), sessionFields(before));
+        final restarted = Client(
+          seed.clientName,
+          database: seed.database,
+          httpClient: api,
+        );
+        addTearDown(restarted.dispose);
+        FakeMatrixApi.client = restarted;
+        await restarted.init(waitForFirstSync: false);
+        expect(restarted.isLogged(), isTrue);
+        expect(restarted.identityKey, identityKey);
+        expect(api.deviceKeyUploads, 0);
+      },
+    );
+  });
+}
